# Public Firebase web configuration. Do not add real values to this repository.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Billing is disabled by default. Only enable it after a verified webhook writes userEntitlements.
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY_CHECKOUT_URL=
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY_CHECKOUT_URL=
NEXT_PUBLIC_STRIPE_AD_FREE_LIFETIME_CHECKOUT_URL=
