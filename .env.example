# Public Firebase web configuration. Do not add real values to this repository.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Premium for everyone until billing is live. Set to "false" to enforce real entitlements
# (free plan: A1 + daily limit; premium via RevenueCat, see docs/monetization.md).
NEXT_PUBLIC_PREMIUM_FOR_ALL=true

# Android/Capacitor app only: absolute URL of the deployed web backend that hosts /api/* (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=

# RevenueCat web checkout. Use the URL template only, without an App User ID or /checkout.
# Example: https://pay.rev.cat/your-link-token
# Keep billing disabled until the RevenueCat webhook has been deployed and tested.
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_REVENUECAT_BILLING_ENVIRONMENT=sandbox
NEXT_PUBLIC_REVENUECAT_PURCHASE_LINK_SANDBOX_TEMPLATE=
NEXT_PUBLIC_REVENUECAT_PURCHASE_LINK_PRODUCTION_TEMPLATE=

# Server-only: RevenueCat webhook verification. Never expose or commit these values.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_V1_SECRET_API_KEY=
REVENUECAT_PREMIUM_MONTHLY_PRODUCT_ID=
REVENUECAT_PREMIUM_YEARLY_PRODUCT_ID=
REVENUECAT_PREMIUM_LIFETIME_PRODUCT_ID=

# Server-only: Firebase Admin credentials used by the webhook to update Firestore.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
