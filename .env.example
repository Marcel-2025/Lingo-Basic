# Public Firebase web configuration. Do not add real values to this repository.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: "false" aktiviert das Free-Verhalten (Tagesziel als Kartenlimit). Standard: alle Nutzer Premium.
NEXT_PUBLIC_PREMIUM_FOR_ALL=
